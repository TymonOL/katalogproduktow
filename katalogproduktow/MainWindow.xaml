<Window x:Class="katalogproduktow.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:katalogproduktow"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <StackPanel Margin="20,20,20,20">
        <TextBlock Text="Nazwa produktu" />
        <TextBox x:Name="NazwaTextBox" Margin="0,5,0,10" />
        
        <TextBlock Text="Cena" />
        <TextBox x:Name="CenaTextBox" Margin="0,5,0,10" />

        <TextBlock Text="Ilosc" />
        <TextBox x:Name="IloscTextBox" Margin="0,5,0,10" />

        <Button x:Name="ObliczButton" Content="Oblicz wartosc" Click="Oblicz"/>

        <TextBlock x:Name="WynikTextBlock" FontSize="16" />
    </StackPanel>
</Window>
